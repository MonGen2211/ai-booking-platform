# Create the ai_booking database in phpMyAdmin first.
# Replace the placeholder locally; do not commit backend/.env.
DATABASE_URL="mysql://root:replace_with_local_password@localhost:3306/ai_booking"

# Replace both placeholders with independent, randomly generated secrets in backend/.env.
# Never use these example values to run the application.
ACCESS_TOKEN_SECRET="replace_with_a_random_access_signing_secret"
REFRESH_TOKEN_SECRET="replace_with_a_different_random_refresh_signing_secret"
FRONTEND_ORIGIN="http://localhost:5173"
APPOINTMENT_UPLOAD_DIR="./uploads"
